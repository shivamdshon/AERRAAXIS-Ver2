# Copy this file to .env.local for local testing with `vercel dev`.
# In production, set these in the Vercel dashboard:
# Project -> Settings -> Environment Variables (do NOT commit real values to git).

# From resend.com/api-keys after creating a Resend account
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Where submitted briefs should land
CONTACT_TO_EMAIL=info@aerraaxis.com

# Must be an address on a domain you have verified inside Resend
# (see README.md — until your domain is verified, sending will fail)
CONTACT_FROM_EMAIL=AERRA AXIS <brief@yourdomain.com>
